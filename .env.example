# Required. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: fallback LLM if Groq fails (https://aistudio.google.com/apikey)
# Optional: override the Groq chat model (default openai/gpt-oss-120b)
GROQ_CHAT_MODEL=

GEMINI_API_KEY=

# Optional but recommended on Vercel: shared rate limiting (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: extra comma-separated origins allowed to call the API (e.g. a custom domain)
ALLOWED_ORIGINS=

# Optional: global daily cap across all visitors (default 1500)
GLOBAL_DAILY_CAP=
